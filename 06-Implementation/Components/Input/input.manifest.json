    { "part": "LeadingIcon", "required": false, "type": "Icon Slot", "description": "Icon before text" },
    { "part": "TrailingIcon", "required": false, "type": "Icon Slot", "description": "Action icon after text" },
    { "part": "HelperText", "required": false, "type": "Text Slot", "description": "Supporting hint text" },
    { "part": "ErrorText", "required": false, "type": "Text Slot", "description": "Validation error message" }
